	Deactivated		: Tc2_Utilities.TIMESTRUCT;	// Time of alarm deactiovation
	Acknowledged	: Tc2_Utilities.TIMESTRUCT;	// Time of alarm acknowlidgemenet
END_STRUCT
END_TYPE
]]></Declaration>
