      <Declaration><![CDATA[METHOD PROTECTED LogInfo
VAR_INPUT
	message	: Tc2_System.T_MaxString;
END_VAR 
VAR
	sb	: ZigaLibs_Core.FB_StringBuilder;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT ValidateLogger() THEN
	RETURN;
END_IF

_logger.LogInfo(
	sb.AddString(GetLogPrefix())
		.AddString(message)
		.Create());]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogWarning" Id="{0b19abfe-188a-0b89-0988-a4f83b922ff2}" FolderPath="Methods\Protected\">
      <Declaration><![CDATA[METHOD PROTECTED LogWarning
VAR_INPUT
	message : Tc2_System.T_MaxString;
END_VAR
VAR
	sb	: ZigaLibs_Core.FB_StringBuilder;
END_VAR]]></Declaration>
      <Implementation>
