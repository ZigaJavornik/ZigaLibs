		.Create());]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveResponsePrefix" Id="{4954fdff-fd68-0e90-1499-c7a34c914582}" FolderPath="Methods\Protected\">
      <Declaration><![CDATA[// Removes the prefix from the received response and returns the trimmer string
METHOD PROTECTED RemoveResponsePrefix : Tc2_System.T_MaxString
VAR_INPUT
	sentCommand	: Tc2_System.T_MaxString;
	response	: Tc2_System.T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Remove prefix
RemoveResponsePrefix := Tc2_Standard.DELETE(
	STR := response, 
	LEN := Tc2_Standard.LEN(sentCommand) + LEN(EndurancePyrometerConstants.Commands.ResponsePrefix),
	POS := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveResponseSuffix" Id="{4915a903-7705-0a3b-161e-4b16ec3af71a}" FolderPath="Methods\Protected\">
      <Declaration><![CDATA[// Removes the suffix from the received response and returns the trimmer string
METHOD PROTECTED RemoveResponseSuffix : T_MaxString
VAR_INPUT
	response	: STRING;
END_VAR
VAR
	suffixPosition	: INT;	
	trimmedResponse		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Remove suffix - sometimes the suffix is sent in multiples (no idea why Fluke does this), remove all occurences!	
suffixPosition := Tc2_Standard.FIND(STR1 := response, STR2 := EndurancePyrometerConstants.Commands.ResponseSuffix);
trimmedResponse := response;
IF suffixPosition <> 0 THEN
	response := Tc2_Standard.LEFT(STR := trimmedResponse, SIZE := suffixPosition - 1);		
END_IF

RemoveResponseSuffix := trimmedResponse;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ValidateLogger" Id="{bfa71228-4c25-0067-0921-10d23c4b1177}" FolderPath="Methods\Protected\">
      <Declaration><![CDATA[METHOD PROTECTED ValidateLogger : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ValidateLogger := __ISVALIDREF(_logger);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>